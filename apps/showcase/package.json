{
	"name": "@lemn-ltd/ui-showcase",
	"private": true,
	"version": "0.0.0",
	"type": "module",
	"scripts": {
		"build": "vite build",
		"benchmark:visualizations": "node tests/benchmark/visualization-performance.mjs",
		"cf:build": "pnpm run build",
		"cf:dry-run": "CLOUDFLARE_ENV=production pnpm run cf:build && wrangler deploy --env production --dry-run --outdir dist/cloudflare",
		"cf:types": "wrangler types worker-configuration.d.ts --include-runtime false",
		"cf:whoami": "wrangler whoami",
		"check": "tsc --noEmit",
		"dev": "vite dev --host 0.0.0.0 --port 6500 --strictPort",
		"fidelity:capture-masters": "node tests/fidelity/capture-masters.ts",
		"fidelity:contact-sheets": "node tests/fidelity/build-contact-sheets.ts",
		"kill": "lsof -ti :6500 | xargs kill -9 2>/dev/null || true; pkill -9 -f 'vite.*apps/showcase' 2>/dev/null || true",
		"observe:local:explorer-api": "curl -fsS http://localhost:6500/cdn-cgi/explorer/api",
		"observe:production:tail": "wrangler tail --env production --format json",
		"test": "vitest run",
		"test:e2e": "playwright test",
		"deploy:production": "pnpm --dir ../.. deploy:showcase:prod"
	},
	"dependencies": {
		"@lemn-ltd/brand-contract": "workspace:1.0.0",
		"@lemn-ltd/brand-studio": "workspace:*",
		"@lemn-ltd/provider-registry": "workspace:0.1.0",
		"@lemn-ltd/showcase-kit": "workspace:*",
		"@lemn-ltd/ui": "workspace:*",
		"react": "catalog:",
		"react-dom": "catalog:",
		"react-router-dom": "catalog:"
	},
	"devDependencies": {
		"@axe-core/playwright": "catalog:",
		"@cloudflare/vite-plugin": "1.42.1",
		"@cloudflare/workers-types": "4.20260617.1",
		"@faker-js/faker": "catalog:",
		"@playwright/test": "catalog:",
		"@types/node": "catalog:",
		"@types/react": "catalog:",
		"@types/react-dom": "catalog:",
		"@vitejs/plugin-react": "6.0.1",
		"happy-dom": "20.9.0",
		"typescript": "catalog:",
		"vite": "8.0.16",
		"vitest": "catalog:",
		"wrangler": "4.103.0"
	}
}
