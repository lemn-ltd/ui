{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "dev-appranks-ui",
  "account_id": "d8642f551bb031f9be852dff0c2b909d",
  "main": "src/worker/index.ts",
  "compatibility_date": "2026-05-14",
  "compatibility_flags": ["nodejs_compat"],
  "workers_dev": true,
  "assets": {
    "directory": "./dist/client",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    "run_worker_first": [
      "/_status",
      "/_status.json",
      "/health",
      "/health/ready",
      "/health/deep",
      "/catalog.json",
      "/llms.txt",
      "/llms-full.txt",
    ],
  },
  "observability": {
    "enabled": true,
    "head_sampling_rate": 1,
  },
  "vars": {
    "DEPLOYMENT_ENVIRONMENT": "local",
    "BUILD_VERSION": "0.0.0",
    "BUILD_GIT_SHA": "local",
    "BUILD_TIME": "local",
  },
  "dev": {
    "port": 6500,
    "local_protocol": "http",
  },
  "env": {
    "production": {
      "name": "appranks-ui",
      "routes": [
        {
          "pattern": "ui.appranks.com",
          "custom_domain": true,
        },
      ],
      "observability": {
        "enabled": true,
        "head_sampling_rate": 1,
      },
      "vars": {
        "DEPLOYMENT_ENVIRONMENT": "production",
        "BUILD_VERSION": "0.0.0",
        "BUILD_GIT_SHA": "local",
        "BUILD_TIME": "local",
      },
    },
  },
}
