{
  "name": "@lemn-ltd/ui-docs",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "build": "node ../../scripts/sync-docs-changelog.mjs && astro build",
    "cf:dry-run": "pnpm run build && wrangler deploy --dry-run --outdir dist/cloudflare",
    "check": "node ../../scripts/sync-docs-changelog.mjs --check && astro check",
    "deploy:production": "pnpm --dir ../.. deploy:docs:prod",
    "dev": "node ../../scripts/sync-docs-changelog.mjs && astro dev --host 0.0.0.0 --port 6600",
    "preview": "astro preview --host 0.0.0.0 --port 6601"
  },
  "dependencies": {
    "@astrojs/starlight": "0.41.0",
    "@lemn-ltd/ui": "workspace:0.3.1",
    "astro": "7.0.2"
  },
  "devDependencies": {
    "@astrojs/check": "0.9.9",
    "typescript": "catalog:",
    "wrangler": "4.103.0"
  }
}
