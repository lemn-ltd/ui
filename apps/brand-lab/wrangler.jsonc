{
	"$schema": "node_modules/wrangler/config-schema.json",
	"name": "dev-lemn-ui-brand-lab",
	"main": "src/worker/index.ts",
	"compatibility_date": "2026-06-24",
	"compatibility_flags": ["nodejs_compat"],
	"workers_dev": false,
	"assets": {
		"directory": "./dist/client",
		"binding": "ASSETS",
		"run_worker_first": ["/", "/index.html", "/api/*"]
	},
	"kv_namespaces": [
		{
			"binding": "BRAND_PROJECTS",
			// Local-only MVP namespace. This app intentionally has no production deploy target.
			"id": "00000000000000000000000000000001"
		}
	],
	"observability": {
		"enabled": true,
		"head_sampling_rate": 1
	},
	"vars": {
		"DEPLOYMENT_ENVIRONMENT": "local"
	},
	"dev": {
		"port": 6501,
		"local_protocol": "http"
	}
}
