{
	"name": "@lemn-ltd/brand-runtime",
	"version": "0.0.0",
	"type": "module",
	"main": "./dist/index.js",
	"types": "./dist/index.d.ts",
	"files": [
		"dist",
		"README.md",
		"CHANGELOG.md",
		"LICENSE"
	],
	"exports": {
		".": {
			"types": "./dist/index.d.ts",
			"default": "./dist/index.js"
		},
		"./server": {
			"types": "./dist/server.d.ts",
			"default": "./dist/server.js"
		}
	},
	"publishConfig": {
		"registry": "https://npm.pkg.github.com",
		"access": "restricted"
	},
	"scripts": {
		"build": "rm -rf dist && tsc",
		"check": "tsc --noEmit",
		"test": "vitest run",
		"prepublishOnly": "pnpm --dir ../.. publish:packages:verify"
	},
	"dependencies": {
		"@lemn-ltd/brand-contract": "workspace:0.2.0",
		"zod": "4.4.3"
	},
	"devDependencies": {
		"typescript": "catalog:",
		"vitest": "catalog:"
	}
}
