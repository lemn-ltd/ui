{
  "name": "appranks-ui-workspace",
  "private": true,
  "packageManager": "pnpm@11.8.0",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "build": "turbo run build",
    "check": "turbo run check",
    "test": "turbo run test",
    "validate": "pnpm validate:brand-neutrality && pnpm validate:boundaries && pnpm validate:release",
    "validate:release": "node scripts/sync-docs-changelog.mjs --check",
    "validate:brand-neutrality": "node scripts/check-brand-neutrality.mjs",
    "validate:boundaries": "node scripts/check-ui-boundaries.mjs",
    "sync:docs-changelog": "node scripts/sync-docs-changelog.mjs",
    "dev:showcase": "pnpm --filter @appranks/ui-showcase run dev",
    "dev:docs": "pnpm --filter @appranks/ui-docs run dev",
    "kill:showcase": "pnpm --filter @appranks/ui-showcase run kill",
    "build:docs": "pnpm --filter @appranks/ui-docs run build",
    "check:docs": "pnpm --filter @appranks/ui-docs run check",
    "deploy:docs": "pnpm --filter @appranks/ui-docs run deploy:production",
    "deploy:showcase": "pnpm --filter @appranks/ui-showcase run deploy:production",
    "publish:ui": "pnpm --filter @appranks/ui publish --access restricted --no-git-checks",
    "changeset": "changeset",
    "version:packages": "changeset version && pnpm sync:docs-changelog",
    "release": "pnpm build && pnpm publish:ui"
  },
  "devDependencies": {
    "@changesets/cli": "^2.29.7",
    "@biomejs/biome": "catalog:",
    "@playwright/test": "catalog:",
    "@vitejs/plugin-react": "6.0.1",
    "@vitest/coverage-v8": "catalog:",
    "happy-dom": "20.9.0",
    "turbo": "catalog:",
    "typescript": "catalog:",
    "vite": "8.0.16",
    "vitest": "catalog:"
  }
}
