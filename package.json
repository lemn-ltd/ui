{
  "name": "appranks-ui-workspace",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@11.8.0",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "build": "turbo run build",
    "check": "turbo run check",
    "test": "turbo run test",
    "validate": "pnpm validate:package-identity && pnpm validate:brand-neutrality && pnpm validate:boundaries && pnpm validate:release && pnpm validate:release-contracts",
    "validate:package-identity": "node scripts/check-package-identity.mjs",
    "validate:release": "node scripts/sync-docs-changelog.mjs --check",
    "validate:release-contracts": "node --test tests/contract/*.test.ts",
    "validate:release-hosts": "node scripts/check-release-hosts.mjs",
    "validate:release-preconditions": "pnpm validate && pnpm validate:release-hosts",
    "validate:brand-neutrality": "node scripts/check-brand-neutrality.mjs",
    "validate:boundaries": "node scripts/check-ui-boundaries.mjs",
    "sync:docs-changelog": "node scripts/sync-docs-changelog.mjs",
    "dev:showcase": "pnpm --filter @appranks/ui-showcase run dev",
    "dev:docs": "pnpm --filter @appranks/ui-docs run dev",
    "kill:showcase": "pnpm --filter @appranks/ui-showcase run kill",
    "build:docs": "pnpm --filter @appranks/ui-docs run build",
    "check:docs": "pnpm --filter @appranks/ui-docs run check",
    "deploy:docs": "pnpm --filter @appranks/ui-docs run deploy:production",
    "deploy:showcase": "pnpm --filter @appranks/ui-showcase run deploy:production",
    "pack:ui": "pnpm validate:package-identity && node scripts/smoke-package-tarball.mjs",
    "preflight:cloudflare:release": "node scripts/release/cloudflare-preflight.ts",
    "release:preflight": "pnpm validate:release-preconditions && pnpm preflight:cloudflare:release",
    "publish:ui:internal": "pnpm --filter @lemn-ltd/ui publish --access restricted --no-git-checks",
    "publish:ui": "pnpm release:preflight && pnpm publish:ui:internal",
    "smoke:showcase:local": "CLOUDFLARE_ENV=production pnpm --filter @appranks/ui-showcase run cf:build && node scripts/release/showcase-assets-smoke.ts",
    "smoke:cloudflare:release": "node scripts/release/cloudflare-preflight.ts --require-resources",
    "smoke:release:production": "node scripts/release/deployment-smoke.ts",
    "changeset": "changeset",
    "version:packages": "changeset version && pnpm sync:docs-changelog",
    "release": "pnpm release:preflight && pnpm build && pnpm publish:ui:internal"
  },
  "devDependencies": {
    "@changesets/cli": "^2.29.7",
    "@biomejs/biome": "catalog:",
    "@playwright/test": "catalog:",
    "@vitejs/plugin-react": "6.0.1",
    "@vitest/coverage-v8": "catalog:",
    "happy-dom": "20.9.0",
    "jsonc-parser": "3.3.1",
    "turbo": "catalog:",
    "typescript": "catalog:",
    "vite": "8.0.16",
    "vitest": "catalog:",
    "yaml": "2.9.0"
  }
}
