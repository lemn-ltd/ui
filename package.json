{
	"name": "lemn-ui-workspace",
	"private": true,
	"type": "module",
	"packageManager": "pnpm@11.8.0",
	"engines": {
		"node": ">=22"
	},
	"scripts": {
		"build": "turbo run build",
		"check": "turbo run check",
		"check:release-scripts": "tsc --noEmit -p scripts/release/tsconfig.json",
		"check:zero-trust": "tsc --noEmit -p tooling/tsconfig.json",
		"test": "turbo run test",
		"test:zero-trust": "node --test tooling/tests/unit/ops/reconcile-zero-trust.test.ts",
		"test:tooling": "node --test tooling/tests/unit/ops/*.test.ts tooling/tests/unit/validation/*.test.ts tooling/tests/unit/local/*.test.ts",
		"test:portal:e2e": "pnpm --filter @lemn-ltd/ui-portal run test:e2e",
		"visual:update:linux": "node scripts/test/update-linux-visual-snapshots.mjs",
		"validate": "pnpm validate:standard",
		"validate:quick": "node tooling/src/validation/quick.ts",
		"validate:quick:fix": "node tooling/src/validation/quick.ts --fix",
		"validate:standard": "node tooling/src/validation/standard.ts",
		"validate:full": "node tooling/src/validation/full.ts",
		"validate:policy": "pnpm validate:agentops && pnpm validate:script-catalog && pnpm check:zero-trust && pnpm check:release-scripts && pnpm test:tooling && pnpm validate:identity && pnpm validate:domains && pnpm validate:package-identity && pnpm validate:brand-neutrality && pnpm validate:branding-vnext && pnpm validate:boundaries && pnpm validate:bundles && pnpm validate:ui-portal-zero-legacy && pnpm validate:release",
		"validate:agentops": "node scripts/check-agentops-managed-files.mjs",
		"validate:script-catalog": "node --test tests/contract/script-catalog.test.ts",
		"validate:identity": "node scripts/check-repository-identity.mjs",
		"validate:domains": "node scripts/check-public-domains.mjs",
		"validate:package-identity": "node scripts/check-package-identity.mjs",
		"validate:release": "node scripts/sync-docs-changelog.mjs --check",
		"validate:release-contracts": "node --test tests/contract/*.test.ts",
		"validate:release-hosts": "node scripts/check-release-hosts.mjs",
		"validate:release-preconditions": "pnpm validate",
		"validate:bundles": "node scripts/check-ui-bundles.mjs",
		"validate:brand-neutrality": "node scripts/check-brand-neutrality.mjs",
		"validate:branding-vnext": "node scripts/check-branding-vnext.mjs",
		"validate:boundaries": "node scripts/check-ui-boundaries.mjs && pnpm --dir packages/ui run validate:boundaries",
		"validate:ui-portal-zero-legacy": "node scripts/check-ui-portal-zero-legacy.mjs",
		"pipeline:local": "node tooling/src/validation/local-pipeline.ts",
		"pipeline:visual:local": "pnpm visual:update:linux",
		"hooks:install": "node tooling/src/local/install-git-hooks.ts",
		"dry-run:portal": "pnpm --filter @lemn-ltd/ui-portal run cf:dry-run",
		"dry-run:docs": "pnpm --filter @lemn-ltd/ui-docs run cf:dry-run",
		"sync:docs-changelog": "node scripts/sync-docs-changelog.mjs",
		"dev:portal": "pnpm --filter @lemn-ltd/ui-portal run dev",
		"dev:docs": "pnpm --filter @lemn-ltd/ui-docs run dev",
		"kill:portal": "pnpm --filter @lemn-ltd/ui-portal run kill",
		"build:docs": "pnpm --filter @lemn-ltd/ui-docs run build",
		"check:docs": "pnpm --filter @lemn-ltd/ui-docs run check",
		"deploy:docs": "pnpm deploy:docs:prod",
		"deploy:portal": "pnpm deploy:portal:prod",
		"deploy:docs:prod": "pnpm guard:release:mutation && test -n \"$PUBLIC_BUILD_VERSION\" && test -n \"$PUBLIC_BUILD_GIT_SHA\" && test -n \"$PUBLIC_BUILD_TIME\" && pnpm --filter @lemn-ltd/ui-docs run build && pnpm --dir apps/docs exec wrangler deploy --config wrangler.jsonc",
		"deploy:portal:prod": "pnpm guard:release:mutation && node scripts/release/ui-portal-production-rollout.ts",
		"rollout:portal:prod": "pnpm guard:release:mutation && node scripts/release/ui-portal-production-rollout.ts",
		"build:packages:release": "pnpm --filter @lemn-ltd/brand-contract run build && pnpm --filter @lemn-ltd/ui run build && pnpm --filter @lemn-ltd/brand-runtime run build && pnpm --filter @lemn-ltd/brand-studio run build",
		"pack:packages": "pnpm validate:package-identity && node scripts/smoke-package-set-tarballs.mjs",
		"preflight:cloudflare:release": "node scripts/release/cloudflare-preflight.ts",
		"guard:release:ref": "node scripts/release/release-ref-guard.ts",
		"guard:release:mutation": "node scripts/release/release-mutation-guard.ts",
		"access:plan": "node tooling/src/ops/reconcile-zero-trust.ts plan --environment production",
		"access:apply": "pnpm guard:release:ref && node tooling/src/ops/reconcile-zero-trust.ts apply --environment production --confirm-project lemn-ui",
		"release:preflight": "pnpm guard:release:ref && pnpm validate:release-preconditions",
		"publish:packages:verify": "pnpm guard:release:ref && node scripts/release/verify-package-dists.ts && pnpm pack:packages",
		"publish:packages:release": "pnpm guard:release:ref && node scripts/release/publish-package-release.ts",
		"prepare:packages:release": "pnpm guard:release:ref && node scripts/release/prepare-package-release.ts",
		"smoke:packages:github-packages": "node scripts/release/verify-published-package-consumer.ts",
		"smoke:portal:local": "pnpm --filter @lemn-ltd/ui-portal run cf:build && node scripts/release/ui-portal-assets-smoke.ts",
		"smoke:cloudflare:release": "node scripts/release/cloudflare-preflight.ts --require-resources",
		"smoke:release:production": "node scripts/release/deployment-smoke.ts",
		"changeset": "node scripts/release/changeset-command.ts",
		"changeset:add": "pnpm changeset add",
		"changeset:status": "pnpm changeset status",
		"version:packages": "pnpm changeset version && pnpm sync:docs-changelog",
		"release": "pnpm release:preflight && pnpm check && pnpm test && pnpm build:packages:release && pnpm publish:packages:release"
	},
	"devDependencies": {
		"@types/node": "catalog:",
		"@changesets/cli": "2.29.7",
		"@biomejs/biome": "catalog:",
		"@playwright/test": "catalog:",
		"@vitejs/plugin-react": "6.0.1",
		"@vitest/coverage-v8": "catalog:",
		"happy-dom": "20.9.0",
		"jsonc-parser": "3.3.1",
		"turbo": "catalog:",
		"typescript": "catalog:",
		"vite": "8.0.16",
		"vitest": "catalog:",
		"yaml": "2.9.0"
	}
}
